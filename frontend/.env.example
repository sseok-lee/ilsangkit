# ===========================
# Frontend Environment Variables
# ===========================
# 주의: 이 파일은 예시입니다. 실제 설정값을 .env 파일에 입력하세요.
# WARNING: This file is a template. Set actual values in .env file.
#
# NUXT_PUBLIC_* 변수는 클라이언트에 노출됩니다.
# (NUXT_PUBLIC_* variables are exposed to client)

# ===========================
# 필수 환경 변수 (REQUIRED)
# ===========================

# 백엔드 API URL (Backend API Base URL)
# 개발: http://localhost:8000
# 프로덕션: https://api.example.com
NUXT_PUBLIC_API_BASE=http://localhost:8000

# 카카오맵 JavaScript API 키 (Kakao Map JavaScript API Key)
# 출처: https://developers.kakao.com
# 사용: 웹 지도 표시, 위치 검색
NUXT_PUBLIC_KAKAO_MAP_KEY=your-kakao-map-api-key

# ===========================
# 선택 환경 변수 (OPTIONAL)
# ===========================

# Google Analytics 측정 ID (Google Analytics Measurement ID)
# 출처: https://analytics.google.com
# 형식: G-로 시작하는 ID (예: G-XXXXXXXXXX)
# 비워두면 GA 비활성화
NUXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Mock Service Worker 비활성화 플래그 (Disable MSW flag)
# 백엔드 API가 준비되면 'true'로 설정하여 MSW 비활성화
# 값: true | false (기본값: false)
NUXT_PUBLIC_DISABLE_MSW=false

# NCP (네이버 클라우드 플랫폼) Maps Static Map API
# 출처: https://console.ncloud.com → AI·Application Service → Maps → Application 등록 → Static Map 체크
# 사용: 부동산 상세 og:image 에 네이버 지도 썸네일 생성 (검색 결과 CTR ↑)
# 미설정 시 자동으로 기존 SVG OG 카드(/og)로 fallback 됨
# ⚠️ backend 의 NAVER_CLIENT_ID/SECRET (developers.naver.com 검색 API) 와 다른 키
NCP_MAP_CLIENT_ID=
NCP_MAP_CLIENT_SECRET=
