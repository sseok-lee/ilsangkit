// 체육시설 테이블
model Sports {
  id          String   @id @db.VarChar(50)
  name        String   @db.VarChar(200) // faci_nm
  address     String?  @db.VarChar(500) // faci_road_addr (도로명주소)
  roadAddress String?  @db.VarChar(500) // faci_road_addr
  lat         Decimal? @db.Decimal(10, 7) // faci_lat
  lng         Decimal? @db.Decimal(10, 7) // faci_lot
  city        String   @db.VarChar(50) // addr_ctpv_nm (정규화)
  district    String   @db.VarChar(50) // addr_cpb_nm
  bjdCode     String?  @db.VarChar(5)
  sourceId    String   @unique @db.VarChar(100) // MD5(faci_nm + faci_road_addr)
  sourceUrl   String?  @db.VarChar(500)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  syncedAt    DateTime @default(now())

  // 체육시설 전용 필드
  faciGbNm       String?  @db.VarChar(50) // faci_gb_nm (시설구분: 공공/민간)
  fcobNm         String?  @db.VarChar(100) // fcob_nm (업종명: 축구장 등)
  ftypeNm        String?  @db.VarChar(100) // ftype_nm (시설유형명)
  fmngCpNm       String?  @db.VarChar(100) // fmng_cp_nm (소유주체시도명)
  fmngCpbNm      String?  @db.VarChar(100) // fmng_cpb_nm (소유주체시군구명)
  faciGfa        Decimal? @db.Decimal(15, 2) // faci_gfa (시설총면적)
  standCptPsnCnt Int? // stand_cpt_psn_cnt (관람석수용인원수)
  faciHomepage   String?  @db.VarChar(500) // faci_homepage (홈페이지)
  faciStatCd     String?  @db.VarChar(10) // faci_stat_cd (시설상태코드: 00=정상)
  addrCtpvNm     String?  @db.VarChar(50) // addr_ctpv_nm (시도명)
  addrCpbNm      String?  @db.VarChar(50) // addr_cpb_nm (시군구명)
  addrEmdNm      String?  @db.VarChar(100) // addr_emd_nm (읍면동명)
  nationYn       String?  @db.VarChar(1) // nation_yn (국가시설Y/N)
  fmngTypeGbNm   String?  @db.VarChar(100) // fmng_type_gb_nm (관리유형구분)
  delYn          String?  @db.VarChar(1) // del_yn (삭제여부Y/N)
  rowNum         Int? // row_num (행번호)

  @@index([city, district])
  @@index([lat, lng])
  @@index([bjdCode])
  @@index([ftypeNm])
  @@index([viewCount])
  @@index([name])
}

// 리뷰 테이블
