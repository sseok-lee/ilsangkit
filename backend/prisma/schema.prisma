  method      String? @db.VarChar(100) // 충전방식
  zcode       String? @db.VarChar(10) // 시도코드
  zscode      String? @db.VarChar(10) // 시군구코드
  kind        String? @db.VarChar(10) // 시설구분코드
  kindDetail  String? @db.VarChar(10) // 시설구분상세코드
