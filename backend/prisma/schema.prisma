  limitYn     String? @db.VarChar(1) // 이용제한여부 (Y/N)
  limitDetail String? @db.VarChar(500) // 이용제한상세
  delYn       String? @db.VarChar(1) // 삭제여부 (Y/N)
  delDetail   String? @db.VarChar(500) // 삭제상세
