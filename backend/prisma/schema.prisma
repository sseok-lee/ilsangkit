// 학교 테이블
model School {
  id          String   @id @db.VarChar(50)
  name        String   @db.VarChar(200)
  address     String?  @db.VarChar(500)
  roadAddress String?  @db.VarChar(500)
  lat         Decimal? @db.Decimal(10, 7)
  lng         Decimal? @db.Decimal(10, 7)
  city        String   @db.VarChar(50)
  district    String   @db.VarChar(50)
  bjdCode     String?  @db.VarChar(5)
  sourceId    String   @unique @db.VarChar(200)
  sourceUrl   String?  @db.VarChar(500)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  syncedAt    DateTime @default(now())

  // 학교 전용 필드
  schoolLevel     String? @db.VarChar(50)
  foundedDate     String? @db.VarChar(20)
  foundationType  String? @db.VarChar(50)
  branchType      String? @db.VarChar(20)
  operationStatus String? @db.VarChar(20)
  sidoEduCode     String? @db.VarChar(20)
  sidoEduName     String? @db.VarChar(100)
  localEduCode    String? @db.VarChar(20)
  localEduName    String? @db.VarChar(100)
  createdDate     String? @db.VarChar(20)
  modifiedDate    String? @db.VarChar(20)
  dataDate        String? @db.VarChar(20)
  providerCode    String? @db.VarChar(20)
  providerName    String? @db.VarChar(200)

  // NEIS API 추가 필드
  neisSchoolCode  String? @db.VarChar(20) // SD_SCHUL_CODE (NEIS 표준학교코드)
  neisEduCode     String? @db.VarChar(10) // ATPT_OFCDC_SC_CODE
  phoneNumber     String? @db.VarChar(50)
  faxNumber       String? @db.VarChar(50)
  homepageUrl     String? @db.VarChar(500)
  coeducationType String? @db.VarChar(20) // 남/여/남여공학
  highSchoolType  String? @db.VarChar(50) // 일반고/특목고/자율고/특성화고
  dayNightType    String? @db.VarChar(10) // 주간/야간

  enrollments SchoolEnrollment[]
  departments SchoolDepartment[]

  @@index([city, district])
  @@index([lat, lng])
  @@index([bjdCode])
  @@index([schoolLevel])
  @@index([viewCount])
  @@index([name])
}

model SchoolEnrollment {
  id         Int    @id @default(autoincrement())
  schoolId   String @db.VarChar(50)
  year       Int
  grade      Int
  classCount Int?
  school     School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, year, grade])
  @@index([schoolId])
}

model SchoolDepartment {
  id             Int    @id @default(autoincrement())
  schoolId       String @db.VarChar(50)
  departmentName String @db.VarChar(100)
  school         School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, departmentName])
  @@index([schoolId])
}

// 어린이집 테이블
model Childcare {
  id          String   @id @db.VarChar(50)
  name        String   @db.VarChar(200) // crname
  address     String?  @db.VarChar(500) // craddr (지번)
  roadAddress String?  @db.VarChar(500)
  lat         Decimal? @db.Decimal(10, 7) // la
  lng         Decimal? @db.Decimal(10, 7) // lo
  city        String   @db.VarChar(50) // sidoname (정규화)
  district    String   @db.VarChar(50) // sigunname
  bjdCode     String?  @db.VarChar(5)
  sourceId    String   @unique @db.VarChar(100) // stcode
  sourceUrl   String?  @db.VarChar(500)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  syncedAt    DateTime @default(now())

  // 기본 정보
  crtypename   String? @db.VarChar(100) // 어린이집유형명
  crstatusname String? @db.VarChar(50) // 운영상태명
  zipcode      String? @db.VarChar(10) // 우편번호
  crtelno      String? @db.VarChar(50) // 전화번호
  crfaxno      String? @db.VarChar(50) // 팩스번호
  crhome       String? @db.VarChar(500) // 홈페이지
  crrepname    String? @db.VarChar(100) // 대표자명 (CRREPNAME)

  // 시설 정보
  nrtrroomcnt  Int? // 보육실수 (nrtrroomcnt)
  nrtrroomsize String? @db.VarChar(50) // 보육실면적 (nrtrroomsize)
  plgrdco      Int? // 놀이터수 (plgrdco)
  cctvinstlcnt Int? // CCTV설치수 (cctvinstlcnt)
  chcrtescnt   Int? // 차량수 (chcrtescnt)
  crcapat      Int? // 정원 (crcapat)
  crchcnt      Int? // 현원 (crchcnt)

  // 운영 정보
  crcargbname    String? @db.VarChar(100) // 통학차량운영여부 (crcargbname)
  crcnfmdt       String? @db.VarChar(20) // 인가일 (crcnfmdt)
  crpausebegindt String? @db.VarChar(20) // 운영중단시작일 (crpausebegindt)
  crpauseenddt   String? @db.VarChar(20) // 운영중단종료일 (crpauseenddt)
  crabldt        String? @db.VarChar(20) // 폐지일 (crabldt)
  datastdrdt     String? @db.VarChar(20) // 데이터기준일자 (datastdrdt)
  crspec         String? @db.Text // 특이사항 (crspec)

  // 반별 정원 (CLASS_CNT_*)
  classCnt00  Int? // 0세반정원 (CLASS_CNT_00)
  classCnt01  Int? // 1세반정원 (CLASS_CNT_01)
  classCnt02  Int? // 2세반정원 (CLASS_CNT_02)
  classCnt03  Int? // 3세반정원 (CLASS_CNT_03)
  classCnt04  Int? // 4세반정원 (CLASS_CNT_04)
  classCnt05  Int? // 5세반정원 (CLASS_CNT_05)
  classCntM2  Int? // 만2세미만반정원 (CLASS_CNT_M2)
  classCntM5  Int? // 만5세이상반정원 (CLASS_CNT_M5)
  classCntSp  Int? // 장애아반정원 (CLASS_CNT_SP)
  classCntTot Int? // 전체반정원 (CLASS_CNT_TOT)

  // 아동별 현원 (CHILD_CNT_*)
  childCnt00  Int? // 0세아동수 (CHILD_CNT_00)
  childCnt01  Int? // 1세아동수 (CHILD_CNT_01)
  childCnt02  Int? // 2세아동수 (CHILD_CNT_02)
  childCnt03  Int? // 3세아동수 (CHILD_CNT_03)
  childCnt04  Int? // 4세아동수 (CHILD_CNT_04)
  childCnt05  Int? // 5세아동수 (CHILD_CNT_05)
  childCntM2  Int? // 만2세미만아동수 (CHILD_CNT_M2)
  childCntM5  Int? // 만5세이상아동수 (CHILD_CNT_M5)
  childCntSp  Int? // 장애아동수 (CHILD_CNT_SP)
  childCntTot Int? // 전체아동수 (CHILD_CNT_TOT)

  // 직원 현황 (EM_CNT_*)
  emCnt0y  Int? // 보육교사(0년) (EM_CNT_0Y)
  emCnt1y  Int? // 보육교사(1년) (EM_CNT_1Y)
  emCnt2y  Int? // 보육교사(2년) (EM_CNT_2Y)
  emCnt4y  Int? // 보육교사(4년) (EM_CNT_4Y)
  emCnt6y  Int? // 보육교사(6년) (EM_CNT_6Y)
  emCntA1  Int? // 원장 (EM_CNT_A1)
  emCntA2  Int? // 보육교사 (EM_CNT_A2)
  emCntA3  Int? // 특수교사 (EM_CNT_A3)
  emCntA4  Int? // 치료사 (EM_CNT_A4)
  emCntA5  Int? // 영양사 (EM_CNT_A5)
  emCntA6  Int? // 간호사(조무사) (EM_CNT_A6)
  emCntA10 Int? // 조리원 (EM_CNT_A10)
  emCntA7  Int? // 사무원 (EM_CNT_A7)
  emCntA8  Int? // 기타직원 (EM_CNT_A8)
  emCntTot Int? // 전체직원수 (EM_CNT_TOT)

  // 연장보육 현황 (EW_CNT_*)
  ewCnt00  Int? // 0세연장보육 (EW_CNT_00)
  ewCnt01  Int? // 1세연장보육 (EW_CNT_01)
  ewCnt02  Int? // 2세연장보육 (EW_CNT_02)
  ewCnt03  Int? // 3세연장보육 (EW_CNT_03)
  ewCnt04  Int? // 4세연장보육 (EW_CNT_04)
  ewCnt05  Int? // 5세연장보육 (EW_CNT_05)
  ewCntM6  Int? // 만6세이상연장보육 (EW_CNT_M6)
  ewCntTot Int? // 전체연장보육 (EW_CNT_TOT)

  @@index([city, district])
  @@index([lat, lng])
  @@index([bjdCode])
  @@index([crtypename])
  @@index([viewCount])
  @@index([name])
}

