// 월간 집계 변동률 (apt v1, villa/offitel은 v2)
// 동·평형(areaBucket)·매매전월세 단위. trimmed mean 으로 이상치 제거.
model RealEstateTrend {
  id              Int      @id @default(autoincrement())
  propertyType    String   @db.VarChar(20)  // 'apt' v1
  city            String   @db.VarChar(50)
  district        String   @db.VarChar(50)
  dong            String   @db.VarChar(50)
  areaBucket      String   @db.VarChar(20)  // '59㎡대' | '84㎡대' | '114㎡대' | '기타'
  txType          String   @db.VarChar(10)  // 'sale' | 'rent'
  yearMonth       String   @db.VarChar(7)   // 'YYYY-MM'

  avgPrice        BigInt
  txCount         Int
  prevMonthAvg    BigInt?
  prev3MonthAvg   BigInt?
  prevYearAvg     BigInt?
  monthOverMonth  Float?
  qtrOverQtr      Float?
  yearOverYear    Float?

  computedAt      DateTime @default(now())

  @@unique([propertyType, city, district, dong, areaBucket, txType, yearMonth])
  @@index([propertyType, city, district, yearMonth])
  @@index([propertyType, city, district, dong, yearMonth])
}

// 청약 분양정보
model Subscription {
  id                  Int       @id @default(autoincrement())
  houseManageNo       String    @db.VarChar(20)
  pblancNo            String    @db.VarChar(20)
  sourceType          String    @default("APT") @db.VarChar(20) // APT, OFFITEL, REMAINING, PRIVATE_RENT
  houseName           String    @db.VarChar(200)
  houseType           String    @db.VarChar(20) // APT, 오피스텔
  houseDetailType     String?   @db.VarChar(20) // 민영, 국민
  rentType            String?   @db.VarChar(20) // 분양주택, 임대주택
  publicRentType      String?   @db.VarChar(20) // 영구임대|국민임대|장기전세|공공임대|행복주택|역세권청년주택|재개발임대
  regionName          String    @db.VarChar(100)
  supplyLocation      String?   @db.VarChar(500)
  supplyZipCode       String?   @db.VarChar(10)
  totalSupplyCount    Int?
  announcementDate    DateTime?
  receptionStartDate  DateTime?
  receptionEndDate    DateTime?
  specialStartDate    DateTime?
  specialEndDate      DateTime?
  rank1AreaStartDate  DateTime?
  rank1AreaEndDate    DateTime?
  rank1OtherStartDate DateTime?
  rank1OtherEndDate   DateTime?
  rank2AreaStartDate  DateTime?
  rank2AreaEndDate    DateTime?
  rank2OtherStartDate DateTime?
  rank2OtherEndDate   DateTime?
  winnerDate          DateTime?
  contractStartDate   DateTime?
  contractEndDate     DateTime?
  moveInMonth         String?   @db.VarChar(10)
  constructorName     String?   @db.VarChar(200)
  developerName       String?   @db.VarChar(200)
  homepage            String?   @db.VarChar(500)
  pblancUrl           String?   @db.VarChar(500)
  inquiryTel          String?   @db.VarChar(50)
  status              String    @db.VarChar(20) // upcoming, ongoing, closed
  lat                 Decimal?  @db.Decimal(10, 7)
  lng                 Decimal?  @db.Decimal(10, 7)
  geocodedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  unitTypes       SubscriptionUnitType[]
  competitions    SubscriptionCompetition[]
  scores          SubscriptionScore[]
  specialStatuses SubscriptionSpecialStatus[]

  @@unique([houseManageNo, pblancNo, sourceType])
  @@index([sourceType, status])
  @@index([status])
  @@index([announcementDate])
  @@index([regionName])
}

model SubscriptionUnitType {
  id               Int          @id @default(autoincrement())
  subscriptionId   Int
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  modelNo          String       @db.VarChar(10)
  houseType        String?      @db.VarChar(30)
  supplyArea       String?      @db.VarChar(20)
  generalCount     Int?
  specialCount     Int?
  topAmount        Int?
  newlywedsCount   Int?
  multiChildCount  Int?
  firstLifeCount   Int?
  elderlyCount     Int?
  institutionCount Int?
  youthCount       Int?
  newbornCount     Int?
  transferCount    Int?
  etcCount         Int?

  @@index([subscriptionId])
}

// 청약 경쟁률 (순위별/지역별)
model SubscriptionCompetition {
  id              Int          @id @default(autoincrement())
  subscriptionId  Int
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  modelNo         String       @db.VarChar(10)
  houseType       String?      @db.VarChar(30)
  rank            Int // 1순위=1, 2순위=2
  regionCode      String       @db.VarChar(5) // 01=해당지역, 02=기타지역
  regionName      String?      @db.VarChar(20)
  supplyCount     Int? // 공급세대수
  applicantCount  Int? // 접수자수
  competitionRate String?      @db.VarChar(30) // 경쟁률 (문자열)

  @@unique([subscriptionId, modelNo, rank, regionCode])
  @@index([subscriptionId])
}

// 청약 당첨 가점
model SubscriptionScore {
  id             Int          @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  modelNo        String       @db.VarChar(10)
  houseType      String?      @db.VarChar(30)
  regionCode     String       @db.VarChar(5)
  regionName     String?      @db.VarChar(20)
  minScore       String?      @db.VarChar(10) // 최저가점 ("-" 가능)
  maxScore       String?      @db.VarChar(10) // 최고가점
  avgScore       String?      @db.VarChar(10) // 평균가점

  @@unique([subscriptionId, modelNo, regionCode])
  @@index([subscriptionId])
}

// 특별공급 신청현황
model SubscriptionSpecialStatus {
  id                       Int          @id @default(autoincrement())
  subscriptionId           Int
  subscription             Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  houseType                String?      @db.VarChar(30)
  resultName               String?      @db.VarChar(50) // 청약접수 종료 등
  specialSupplyCount       Int? // 특별공급 세대수
  // 유형별 공급세대수
  newlywedsSupply          Int?
  multiChildSupply         Int?
  firstLifeSupply          Int?
  elderlySupply            Int?
  institutionSupply        Int?
  youthSupply              Int?
  newbornSupply            Int?
  transferSupply           Int?
  // 유형별 신청자수 (해당지역)
  newlywedsAreaCount       Int?
  multiChildAreaCount      Int?
  firstLifeAreaCount       Int?
  elderlyAreaCount         Int?
  youthAreaCount           Int?
  newbornAreaCount         Int?
  // 유형별 신청자수 (기타지역)
  newlywedsOtherCount      Int?
  multiChildOtherCount     Int?
  firstLifeOtherCount      Int?
  elderlyOtherCount        Int?
  youthOtherCount          Int?
  newbornOtherCount        Int?
  // 기관추천/이전기관
  institutionDecisionCount Int?
  institutionPrepareCount  Int?
  transferCount            Int?

  @@unique([subscriptionId, houseType])
  @@index([subscriptionId])
}

// LH 공공임대 단지정보
// LH 공공임대 매물 (data.myhome.go.kr/rentalHouseList API)
// 세대 단위 매물 데이터 — hsmpSn이 고유 식별자
model PublicRentalComplex {
  id             Int      @id @default(autoincrement())
  complexCode    String   @db.VarChar(20) // hsmpSn (마이홈 일련번호) — variant 분리 후 non-unique
  complexName    String   @db.VarChar(300) // 도로명 주소 (rnAdres)
  city           String   @db.VarChar(50) // 시/도명 (brtcNm)
  district       String   @db.VarChar(50) // 시/군/구명 (signguNm)
  rentalType     String   @db.VarChar(30) // 공급유형 (suplyTyNm: 매입임대/전세임대 등)
  houseType      String?  @db.VarChar(30) // 주택유형 (houseTyNm: 아파트/오피스텔 등)
  householdCount Int? // 세대수 (hshldCo)
  exclusiveArea  Decimal? @db.Decimal(10, 2) // 전용면적㎡ (suplyPrvuseAr)
  depositAmount     BigInt?  // 보증금원 (bassRentGtn)
  monthlyRent       Int?     // 월임대료원 (bassMtRntchrg)
  conversionDeposit BigInt?  // 전환보증금원 (bassCnvrsGtnLmt)
  landlordAgency    String   @default("LH") @db.VarChar(100) // insttNm
  pnu               String?  @db.VarChar(20)  // 필지번호 (pnu)
  completionDate    String?  @db.VarChar(10)  // 준공일자 (competDe, YYYYMMDD)
  commonArea        Decimal? @db.Decimal(10, 4) // 공용면적㎡ (suplyCmnuseAr)
  heatingMethod     String?  @db.VarChar(50)  // 난방방식 (heatMthdDetailNm)
  buildingStyle     String?  @db.VarChar(50)  // 건물형태 (buldStleNm)
  hasElevator       String?  @db.VarChar(50)  // 승강기설치여부 (elvtrInstlAtNm)
  parkingCount      Int?                       // 주차수 (parkngCo)
  complexNameKor    String?  @db.VarChar(300) // 단지명 (hsmpNm)
  sourceId          String   @unique @db.VarChar(60) // "lh-{hsmpSn}-{suplyTyNm}-{suplyPrvuseAr}"
  lat              Decimal? @db.Decimal(10, 7)
  lng              Decimal? @db.Decimal(10, 7)
  geocodedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([complexCode])
  @@index([lat, lng])
  @@index([city, district])
  @@index([city, rentalType])
  @@index([rentalType])
  @@index([depositAmount])
}

