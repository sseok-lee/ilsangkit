# ===========================
# Backend Environment Variables
# ===========================
# 주의: 이 파일은 예시입니다. 실제 설정값을 .env 파일에 입력하세요.
# WARNING: This file is a template. Set actual values in .env file.

# ===========================
# 필수 환경 변수 (REQUIRED)
# ===========================

# 데이터베이스 연결 문자열 (Database Connection String)
# 형식: mysql://[username]:[password]@[host]:[port]/[database]
#
# 프로덕션 권장: ?connection_limit=30&pool_timeout=20 을 붙여
# 배치 sync와 동시에 돌아도 백엔드 풀이 고갈되지 않도록 함.
# 예: mysql://ilsangkit:***@localhost:3306/ilsangkit?connection_limit=30&pool_timeout=20
DATABASE_URL=mysql://[username]:[password]@[host]:[port]/[database]

# 공공데이터 API 인증 키 (Public Data API Key)
# 출처: https://www.data.go.kr
# 사용: 공공화장실, 쓰레기배출지, 와이파이, 의류수거함, 무인민원발급기 정보 조회
OPENAPI_SERVICE_KEY=your-api-key-here

# 카카오 REST API 키 (Kakao REST API Key)
# 출처: https://developers.kakao.com
# 사용: 역지오코딩 (주소 → 좌표 변환)
KAKAO_REST_API_KEY=your-kakao-rest-api-key-here

# OpenAI API 키 (가이드 콘텐츠 자동 생성용)
# 출처: https://platform.openai.com
# 사용: 뉴스 기반 생활 가이드 글 (gpt-4o-mini) + 썸네일 이미지 (gpt-image-1) 자동 생성
OPENAI_API_KEY=sk-your-openai-api-key-here

# 어린이집 API 키 (Childcare API Keys)
# 출처: https://api.childcare.go.kr
# 사용: 전국 어린이집 기본정보 및 목록 조회
CHILDCARE_BASIC_API_KEY=your-childcare-basic-api-key-here
CHILDCARE_LIST_API_KEY=your-childcare-list-api-key-here

# ===========================
# 선택 환경 변수 (OPTIONAL)
# ===========================

# 서버 포트 (Server Port)
# 기본값: 8000
PORT=8000

# CORS 허용 출처 (CORS Origin)
# 여러 출처는 쉼표로 구분
# 예: http://localhost:3000,https://example.com
# 기본값: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# 실행 환경 (Node Environment)
# 값: development | production | test
# 기본값: development
NODE_ENV=development

# 업로드 디렉토리 (Upload Directory)
# 이미지 등 정적 파일 저장 경로
# 개발: ../assets/images (프로젝트 루트 기준)
# 프로덕션: /home/project2/assets/images
UPLOAD_DIR=../assets/images

# Google Indexing API (서비스 계정 JSON 키 파일 경로)
# 출처: https://console.cloud.google.com → IAM → Service Accounts
# 사용: Google Indexing API로 URL 자동 제출 (부동산 페이지 인덱싱 촉진)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account-key.json

# NEIS Open API 키 (교육행정정보시스템)
# 출처: https://open.neis.go.kr/portal/guide/actKeyPage.do
# 사용: 학교 기본정보, 학생수, 학과정보 조회
NEIS_API_KEY=your-neis-api-key-here

# IndexNow API 키 (네이버/Bing 색인 촉진)
# 용도: 데이터 동기화 후 변경된 URL을 IndexNow 프로토콜로 검색엔진에 즉시 알림
# 키 파일: frontend/public/{INDEXNOW_KEY}.txt 에 동일한 값 저장 필요
INDEXNOW_KEY=
